---
/* OUTCOME — what the system does once it is running.

   The scan layer for operational facts, in the same language as the header
   `facts` block and the decision spread: a hairline-ruled label/value grid,
   no panels, no figures set at display scale. Numbers are stated, never
   dramatised — a metric rendered as a hero statistic reads as marketing, and
   this section's whole credibility rests on it reading as a record.

   Renders nothing at all when a project supplies no `outcome`. That is the
   important behaviour, not a defensive check: a project with no measured
   numbers must be able to say nothing rather than show an empty frame or a
   row of dashes, which would read as results withheld. */

import SectionHead from './SectionHead.astro'

interface OutcomeEntry {
  label: string
  value: string
}

interface Props {
  items?: OutcomeEntry[]
}

const { items } = Astro.props
---

{
  items && items.length > 0 && (
    <section class="section">
      <div class="shell section__inner">
        {/* Em dash index, matching the other unnumbered project-page heads:
            these sections are part of one record, not a numbered sequence. */}
        <SectionHead index="—" label="Outcome" />
        <dl class="outcome" data-reveal>
          {items.map((o) => (
            <div class="outcome__row">
              <dt class="label">{o.label}</dt>
              <dd class="outcome__value subtitle">{o.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  /* Same hairline rhythm as `.facts` and `.spread`, so the page carries one
     rule language rather than a third treatment invented for this block. */
  .outcome {
    border-block-start: 1px solid var(--rule);
  }

  .outcome__row {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: var(--s-4) var(--s-6);
    align-items: baseline;
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--rule);
  }

  .outcome__value {
    color: var(--ink);
  }

  /* The two columns cannot both hold their measure below this width; stacking
     keeps the pair adjacent, which is the only thing the grid was buying. */
  @media (max-width: 40rem) {
    .outcome__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }
  }
</style>
