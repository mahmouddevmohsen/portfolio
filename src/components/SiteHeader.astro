---
/* TOP BAR.

   Sticky, and revealed on scroll-up rather than pinned. Pinned chrome eats
   vertical space on every screen and starts to feel like an application;
   scrolling away entirely — the previous behaviour — left a reader on a long
   page with no route back to navigation without returning to the top. Reveal
   on scroll-up costs nothing while reading and restores the route instantly.

   It never overlays content: it occupies its own band and translates out of
   view, so nothing is ever hidden beneath it.

   The name is suppressed while the rail is visible. The rail owns identity on
   desktop; the bar owns it only once the rail is gone. One statement of
   identity per viewport. */
import Nav from './Nav.astro'
import { SITE } from '../config/site'
---

<header class="bar" data-bar>
  <div class="shell bar__inner">
    <a class="bar__home" href="/">
      <span class="bar__name">{SITE.name}</span>
      <span class="bar__role meta">Business systems</span>
    </a>
    <div class="bar__end">
      <Nav />

      {/* The label names the theme the reader would MOVE TO, not the one they
          are in — a control captioned with the current state reads as a status
          readout and gets clicked expecting nothing to happen.

          Which label shows is decided in CSS from the root attribute, not by
          script. That means it is already correct in the HTML the pre-paint
          script produced, so the control never renders one word and then
          swaps to the other. The visually-hidden fragments make the accessible
          name a whole sentence — "Switch to light theme" — rather than a bare
          adjective. */}
      <button class="theme" type="button" data-theme-toggle>
        <span class="visually-hidden">Switch to </span>
        <span class="theme__label theme__label--light">light</span>
        <span class="theme__label theme__label--dark">dark</span>
        <span class="visually-hidden"> theme</span>
      </button>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    inset-block-start: 0;
    z-index: 30;
    background: var(--canvas);
    border-block-end: 1px solid var(--rule);
    transition: transform var(--dur-2) var(--ease);
  }

  .bar[data-hidden='true'] {
    transform: translateY(-101%);
  }

  .bar__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
    padding-block: var(--s-4);
  }

  .bar__home {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }

  .bar__end {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
  }

  /* Hidden until JS is confirmed present. The control does nothing without
     it, and a dead button is worse than an absent one — the reader clicks,
     gets no response, and concludes the site is broken rather than that a
     feature is unavailable. `.js` is set by the inline script in <head>. */
  .theme {
    display: none;
  }

  :global(.js) .theme {
    display: inline-flex;
    align-items: center;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--rule-strong);
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: var(--t-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }

  .theme:hover,
  .theme:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* One label per theme, chosen by the same attribute that selects the
     palette — so the two can never disagree. */
  .theme__label--dark {
    display: none;
  }

  :global(:root[data-theme='light']) .theme__label--light {
    display: none;
  }

  :global(:root[data-theme='light']) .theme__label--dark {
    display: inline;
  }

  .bar__name {
    font-size: var(--t-meta);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }

  /* The rail carries the name above this width, so the bar stays quiet. */
  @media (min-width: 64.0625rem) {
    .bar__name {
      display: none;
    }
    .bar__role {
      color: var(--ink-2);
    }
  }

  @media (max-width: 40rem) {
    .bar__role {
      display: none;
    }
  }
</style>
