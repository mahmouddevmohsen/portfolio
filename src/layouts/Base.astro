---
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/layout.css'
import '../styles/type.css'
import '../styles/motion.css'
/* Global because the evidence diagrams are now inlined on two different
   routes (the case study and the work index thumbnail) and must resolve the
   same tokens in both. ~2KB, and it replaces a duplicated block. */
import '../styles/diagram.css'
import Rail from '../components/Rail.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { SITE } from '../config/site'

interface Props {
  title: string
  description: string
  /** `article` for project case studies, `website` for everything else. */
  type?: 'website' | 'article'
  /** Error/utility pages that must never be indexed or treated as canonical. */
  noindex?: boolean
}

const { title, description, type = 'website', noindex = false } = Astro.props

/* Canonical + absolute OG URLs.

   `Astro.site` is the RESOLVED origin (see astro.config.mjs): on a preview
   deployment it is that preview's own hostname. Canonical, og:url and og:image
   all describe the document the reader actually loaded, so they must follow
   the build — a preview claiming the production URL as its canonical tells a
   crawler the throwaway build is the authoritative copy of the site.

   The JSON-LD `url` below deliberately does NOT follow it; see there. */
const canonical = new URL(Astro.url.pathname, Astro.site).href

/* Absolute, because crawlers do not resolve relative OG image paths. Shares
   `Astro.site`, so setting the production domain fixes this URL at the same
   moment it fixes every canonical. */
const ogImage = new URL('/og.png', Astro.site).href

/* JSON-LD Person — the machine-readable identity record.

   Sourced entirely from the config, so it cannot drift from what the page
   says. `sameAs` is the profile-identity claim, and it follows `showGithub`:
   the flag reads "hide the link everywhere", and a structured-data entry a
   crawler consumes is not an exception to everywhere.

   `url` is the PRODUCTION origin, not the resolved one. This is an identity
   record — it states where this person is found on the web, which is a fact
   about the person and not about the deployment rendering it. A preview build
   asserting its own hostname as someone's identity URL would be simply wrong.

   Omitted on noindex pages. A Person record attached to a 404 is not wrong,
   but it is a claim made from a page that exists to say nothing is here. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.jobTitle,
  url: SITE.productionDomain,
  email: `mailto:${SITE.email}`,
  ...(SITE.showGithub ? { sameAs: [SITE.githubUrl] } : {}),
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Dark first: the order states which this document prefers, so a UA that
        paints chrome before the stylesheet arrives picks the right one. Both
        are listed because light is genuinely available, not merely tolerated.
        The authoritative declaration is `color-scheme` in tokens.css. */}
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* The one font file, on the critical path. Preloaded so it is fetched in
        parallel with the stylesheet rather than after it — without this the
        browser only discovers the @font-face once CSS has parsed. */}
    <link
      rel="preload"
      href="/fonts/inter-tight-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mahmoud Mohsen — I design systems for businesses that don't have an engineering team." />

    {/* Upgraded from `summary` now that a real 1200x630 asset exists. The
        small card was a deliberate fallback: a large card without an image
        renders as a broken placeholder. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      !noindex && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(person)}
        />
      )
    }

    {/* Inline and in <head>, so it runs BEFORE first paint. A stored light
        preference applied from the deferred module script instead would paint
        the dark default first and then repaint — the flash-of-wrong-theme that
        makes a toggle feel broken.

        `is:inline` keeps it out of the bundle: a bundled module is deferred by
        definition, which is exactly what this must not be.

        Dark needs no attribute, so nothing is applied on the default path.
        localStorage access is wrapped because it throws outright in some
        privacy modes — and the correct surface is already showing there, so
        swallowing it leaves the reader in the right place. */}
    <script is:inline>
      document.documentElement.classList.add('js')
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light'
        }
      } catch (e) {
        /* No stored preference is retrievable; the default already applies. */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Rail />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    {/* Appendix slot — content that belongs after the contact block rather
        than competing with it for the pre-CTA position. Renders nothing when
        a page supplies no `appendix` content, so every other page is
        unaffected. Fill it with a landmark element (<aside>), never a bare
        <div>: anything here sits outside <main> and <footer>, so without one
        it would be unreachable by landmark navigation. */}
    <slot name="appendix" />

    <script>
      const targets = document.querySelectorAll('[data-reveal], [data-assemble]')

      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'))
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-revealed')
              io.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.04 }
        )
        targets.forEach((el) => io.observe(el))
      }

      document.querySelectorAll('[data-assemble]').forEach((group) => {
        group.querySelectorAll('[data-step]').forEach((step, i) => {
          ;(step as HTMLElement).style.setProperty('--step-index', String(i))
        })
      })

      /* ------------------------------------------------------------------
         THEME — dark by default, light on request.

         The attribute is the single source of truth: tokens.css keys the
         light palette off `:root[data-theme='light']`, and the pre-paint
         script in <head> restores it. This only has to flip the attribute and
         record the choice.

         Both values are written, not just 'light'. Storing only the
         non-default would make an explicit choice indistinguishable from
         never having chosen, and the default is then free to change later
         without silently overriding people who already decided.
         ------------------------------------------------------------------ */
      const themeToggle = document.querySelector<HTMLElement>('[data-theme-toggle]')

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const root = document.documentElement
          const nextIsLight = root.dataset.theme !== 'light'

          if (nextIsLight) root.dataset.theme = 'light'
          else delete root.dataset.theme

          try {
            localStorage.setItem('theme', nextIsLight ? 'light' : 'dark')
          } catch (e) {
            /* Unstorable, so the choice lasts this page only. Applying it is
               still the right response to the click. */
          }
        })
      }

      /* ------------------------------------------------------------------
         SECTION POSITION — one observer, two readouts.

         The nav's active link and the rail's progress indicator answer the
         same question: which section is the reader in. Two observers would be
         two answers, and they would disagree at every boundary — the nav
         highlighting one section while the rail counts another is worse than
         neither existing. So this is deliberately a single observer whose
         result is written to both.

         The rail list is built here rather than in Rail.astro because the
         rail renders on every route and only the homepage has numbered
         sections; markup written server-side would describe sections that do
         not exist on a project page.

         rootMargin collapses the viewport to a band across its middle, so
         "current" means the section crossing the reader's eye line rather
         than whichever one happens to touch the top edge. Without it, a short
         section entering at the bottom steals the state from the one being
         read.
         ------------------------------------------------------------------ */
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-section]')
      )

      if (sections.length > 0) {
        const railList = document.querySelector<HTMLElement>('[data-rail-progress]')
        const steps = new Map<string, HTMLElement>()

        if (railList) {
          for (const section of sections) {
            const step = document.createElement('li')
            step.className = 'rail__step'
            step.textContent = section.dataset.section ?? ''
            railList.append(step)
            steps.set(section.id, step)
          }
        }

        const navLinks = Array.from(
          document.querySelectorAll<HTMLAnchorElement>('.nav__link')
        )

        const visible = new Set<string>()

        const paint = () => {
          /* Document order, not observation order: with several sections in
             the band at once the topmost is the one being read. */
          const current = sections.find((s) => visible.has(s.id))?.id
          if (!current) return

          for (const [id, step] of steps) {
            step.dataset.current = String(id === current)
          }

          for (const link of navLinks) {
            const target = link.getAttribute('href')?.split('#')[1]
            const isCurrent = target === current
            link.classList.toggle('is-current', isCurrent)
            /* aria-current is the semantic; the class is only for paint. */
            if (isCurrent) link.setAttribute('aria-current', 'true')
            else link.removeAttribute('aria-current')
          }
        }

        const positionObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) visible.add(entry.target.id)
              else visible.delete(entry.target.id)
            }
            paint()
          },
          { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
        )

        sections.forEach((section) => positionObserver.observe(section))
      }

      /* Reveal-on-scroll-up for the top bar.
         Hidden while moving down the page (reading), restored the moment the
         reader moves back up (navigating). Always shown near the top.
         A small threshold prevents flicker on trackpad jitter, and reduced-
         motion users get the bar pinned rather than sliding. */
      const bar = document.querySelector<HTMLElement>('[data-bar]')
      if (bar) {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
        let last = window.scrollY
        let ticking = false

        const update = () => {
          const y = window.scrollY
          const delta = y - last
          if (Math.abs(delta) > 6) {
            const hide = delta > 0 && y > 160 && !reduced
            bar.dataset.hidden = String(hide)
            last = y
          }
          ticking = false
        }

        addEventListener(
          'scroll',
          () => {
            if (ticking) return
            ticking = true
            requestAnimationFrame(update)
          },
          { passive: true }
        )
      }
    </script>
  </body>
</html>
